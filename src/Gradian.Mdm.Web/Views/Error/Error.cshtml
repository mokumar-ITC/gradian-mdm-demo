@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <h2 class="text-danger">Something went wrong</h2>
    <p class="mb-1">The request could not be completed. Please try again, or contact support if it keeps happening.</p>
    @if (ViewBag.RequestId is string requestId)
    {
        <p class="text-muted small">Request id: <code>@requestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="ProductMaster" asp-action="Index">Go to Product Master</a>
</div>
