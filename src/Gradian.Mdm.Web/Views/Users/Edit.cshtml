@model Gradian.Mdm.Web.Models.UserEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add User" : "Edit User";
}

<div class="pt-3">
    <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@(Model.IsNew ? "Add User" : "Edit User")</h4>
        <a class="btn btn-primary" asp-action="Index">Back to List</a>
    </div>
    <hr />
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <form asp-action="Edit" method="post" autocomplete="off">
        <input type="hidden" asp-for="IsNew" />
        <div class="row row-cols-1 row-cols-md-2 g-3" style="max-width: 820px;">
            <div class="col">
                <label asp-for="Login" class="form-label">User name</label>
                @if (Model.IsNew)
                {
                    <input asp-for="Login" class="form-control" required />
                }
                else
                {
                    <input asp-for="Login" class="form-control" readonly />
                }
            </div>
            <div class="col">
                <label asp-for="DisplayName" class="form-label">Full name</label>
                <input asp-for="DisplayName" class="form-control" />
            </div>
            <div class="col">
                <label asp-for="LevelNo" class="form-label">Access level</label>
                <select asp-for="LevelNo" class="form-select">
                    <option value="1">1 - Viewer: view all data</option>
                    <option value="2">2 - Maker: submit changes for approval</option>
                    <option value="3">3 - Checker: approve / reject, edit directly</option>
                    <option value="4">4 - Admin: everything + manage users</option>
                </select>
            </div>
            <div class="col">
                <label asp-for="Password" class="form-label">@(Model.IsNew ? "Password" : "New password (leave blank to keep)")</label>
                <input asp-for="Password" type="password" class="form-control" minlength="12" autocomplete="new-password" required="@(Model.IsNew)" />
                <div class="form-text">At least 12 characters.</div>
            </div>
            @if (!Model.IsNew)
            {
                <div class="col">
                    <div class="form-check mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Account active (can sign in)</label>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="IsActive" />
            }
        </div>
        <button type="submit" class="btn btn-primary mt-3">@(Model.IsNew ? "Create User" : "Save")</button>
    </form>
</div>
