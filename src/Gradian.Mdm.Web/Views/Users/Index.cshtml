@model IEnumerable<Gradian.Mdm.Core.Entities.UserAccount>
@{
    ViewData["Title"] = "Users & Access";
    var canDo = new Dictionary<int, string>
    {
        [1] = "View all data",
        [2] = "View + submit product changes for approval",
        [3] = "Approve / reject requests, edit products directly, bulk update",
        [4] = "Everything a Checker can do + manage users and column settings"
    };
}

<div class="pt-3">
    @if (TempData["alertMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["alertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Users &amp; Access</h4>
        <a class="btn btn-primary" asp-action="Edit">Add User</a>
    </div>

    <table class="table table-bordered" id="table" data-toggle="table" data-search="true" data-pagination="true" data-page-size="25">
        <thead class="tb-header">
            <tr>
                <th data-sortable="true">User name</th>
                <th data-sortable="true">Name</th>
                <th data-sortable="true">Access level</th>
                <th>Can do</th>
                <th data-sortable="true">Status</th>
                <th data-sortable="true">Last login</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Login</td>
                    <td>@u.DisplayName</td>
                    <td>@u.LevelDesc (@u.LevelNo)</td>
                    <td class="small">@(canDo.TryGetValue(u.LevelNo, out var c) ? c : "")</td>
                    <td><span class="badge rounded-pill @(u.IsActive ? "alert-success" : "alert-danger")">@(u.IsActive ? "Active" : "Disabled")</span></td>
                    <td>@(u.LastLogin?.ToString("dd-MM-yyyy HH:mm:ss 'UTC'"))</td>
                    <td><a asp-action="Edit" asp-route-id="@u.Login" title="Edit" class="btn btn-warning bi-pencil-square text-black"></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
