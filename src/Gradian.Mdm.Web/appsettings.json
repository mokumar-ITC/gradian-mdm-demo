{
  // Committed defaults only. Never put secrets here: set ConnectionStrings:Mdm with `dotnet user-secrets`,
  // the ConnectionStrings__Mdm environment variable, or an App Service connection string / Key Vault reference.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Properties": { "Application": "Gradian.Mdm.Web" }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql",          // "PostgreSql" or "FabricWarehouse"
    "CommandTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "Mdm": ""
  },
  "Security": {
    "LoginAttemptsPerMinute": 10       // per client address; extra attempts get HTTP 429
  },
  "Demo": {
    "ShowDemoAccounts": false,         // lists the demo accounts on the sign-in page; keep false where outsiders can reach the app
    "Password": ""                     // optional hint shown with the demo accounts
  }
}
